#!/bin/sh
# Format staged files with Prettier, then re-stage them.
set -e

staged=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -z "$staged" ]; then
  exit 0
fi

git diff --cached --name-only --diff-filter=ACMR -z |
  xargs -0 npx prettier --ignore-unknown --write

git diff --cached --name-only --diff-filter=ACMR -z |
  xargs -0 git add
