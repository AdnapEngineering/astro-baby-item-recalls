---
import type { GetStaticPaths, Page } from 'astro';
import PageLinks from '../../../components/PageLinks.astro';
import RecallListItem from '../../../components/RecallListItem.tsx';
import Layout from '../../../layouts/Layout.astro';
import { getHazardGroups, type HazardRecallGroup } from '../../../lib/hazards';
import { withBase } from '../../../lib/nav';
import { LIST_PAGE_SIZE } from '../../../lib/pagination';
import type { RecallSummary } from '../../../lib/recall-details';

// Data → routes: the query runs once at build time and each group it returns becomes one or
// more static pages. Page 1 stays at /hazards/<hazard>/, so existing links never change;
// later pages are /hazards/<hazard>/2/ and so on. The group rides along as a prop so no page
// needs a second query.
export const getStaticPaths = (async ({ paginate }) => {
  const groups = await getHazardGroups();
  return groups.flatMap(group =>
    paginate(group.recalls, {
      params: { hazard: group.slug },
      props: { group },
      pageSize: LIST_PAGE_SIZE,
    })
  );
}) satisfies GetStaticPaths;

const { group, page } = Astro.props as {
  group: HazardRecallGroup;
  page: Page<RecallSummary>;
};
const count = page.total;
const paged = page.lastPage > 1;
const pageLabel = paged ? ` (page ${page.currentPage} of ${page.lastPage})` : '';
---

<Layout
  title={`${group.name}${pageLabel} — Baby Safety Site`}
  description={`Children's product recalls that pose a ${group.name.toLowerCase()} hazard.`}
>
  <main id="main" tabindex="-1" class="mx-auto max-w-3xl p-4">
    <a href={withBase('/hazards/')} class="link link-primary mb-4 inline-block text-sm">
      ← All hazards
    </a>
    <h1 class="mb-2 text-2xl font-bold">{group.name}</h1>
    <p class="mb-6 text-base-content/80">
      {count} recall{count === 1 ? '' : 's'} with this hazard, newest first{
        paged && `; showing ${page.start + 1}–${page.end + 1}`
      }. To narrow by brand or product type, <a
        href={withBase(`/recalls/?hazard=${group.slug}`)}
        class="link link-primary">search within these recalls</a
      >.
    </p>

    {/* No client directive: the rows render to static HTML here, with no JS shipped. */}
    <ul class="space-y-3">
      {page.data.map(recall => <RecallListItem recall={recall} />)}
    </ul>

    <PageLinks page={page} firstPage={`/hazards/${group.slug}/`} />
  </main>
</Layout>
