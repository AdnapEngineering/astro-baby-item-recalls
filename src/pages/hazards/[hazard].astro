---
import RecallListItem from '../../components/RecallListItem.tsx';
import Layout from '../../layouts/Layout.astro';
import { getHazardGroups, type HazardRecallGroup } from '../../lib/hazards';
import { withBase } from '../../lib/nav';

// Data → routes: the query runs once at build time and each group it returns becomes one
// static page. The group rides along as a prop so the page needs no second query.
export async function getStaticPaths() {
  const groups = await getHazardGroups();
  return groups.map(group => ({ params: { hazard: group.slug }, props: { group } }));
}

const { group } = Astro.props as { group: HazardRecallGroup };
const count = group.recalls.length;
---

<Layout
  title={`${group.name} — Baby Safety Site`}
  description={`Children's product recalls that pose a ${group.name.toLowerCase()} hazard.`}
>
  <main class="mx-auto max-w-3xl p-4">
    <a href={withBase('/hazards/')} class="link link-primary mb-4 inline-block text-sm">
      ← All hazards
    </a>
    <h1 class="mb-2 text-2xl font-bold">{group.name}</h1>
    <p class="mb-6 text-base-content/80">
      {count} recall{count === 1 ? '' : 's'} with this hazard, newest first.
    </p>

    {/* No client directive: the rows render to static HTML here, with no JS shipped. */}
    <ul class="space-y-3">
      {group.recalls.map(recall => <RecallListItem recall={recall} />)}
    </ul>
  </main>
</Layout>
