---
import Layout from '../../layouts/Layout.astro';
import { getHazardGroups } from '../../lib/hazards';
import { withBase } from '../../lib/nav';

// Build-time query: the deployed page is plain HTML with no database behind it.
const groups = await getHazardGroups();
---

<Layout
  title="Browse by hazard — Baby Safety Site"
  description="Children's product recalls grouped by the hazard they pose."
>
  <main class="mx-auto max-w-3xl p-4">
    <h1 class="mb-2 text-2xl font-bold">Browse by hazard</h1>
    <p class="mb-6 text-base-content/80">
      Recalls grouped by the hazard they pose. A recall appears under every hazard it carries, so
      the counts below add up to more than the number of recalls.
    </p>

    {
      groups.length === 0 ? (
        <div class="alert alert-info">
          <span>No hazards to show yet — the recall database has not been populated.</span>
        </div>
      ) : (
        <ul class="grid gap-3 sm:grid-cols-2">
          {groups.map(group => (
            <li>
              <a
                href={withBase(`/hazards/${group.slug}/`)}
                class="card flex-row items-center justify-between bg-base-200 p-4 hover:bg-base-300"
              >
                <span class="font-semibold">{group.name}</span>
                <span class="badge badge-neutral">{group.recalls.length}</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </main>
</Layout>
