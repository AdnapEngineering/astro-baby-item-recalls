---
import RecallSearch from '../../components/RecallSearch.tsx';
import Layout from '../../layouts/Layout.astro';
import { withBase } from '../../lib/nav';
import { LIST_PAGE_SIZE } from '../../lib/pagination';
import { getRecallDetails } from '../../lib/recall-data';
import { toRecallSummary } from '../../lib/recall-details';
import { HAZARD_TAGS, PRODUCT_TYPES } from '../../lib/recalls';

// Build-time query, so the deployed page has no database behind it. The island gets only
// the first page of rows as props; the full index is the static search-index.json beside it.
const details = await getRecallDetails();
const initial = details.slice(0, LIST_PAGE_SIZE).map(toRecallSummary);
// Only offer hazards that at least one stored recall carries, in the canonical order.
const hazards = HAZARD_TAGS.filter(h =>
  details.some(e => e.hazardTags.some(t => t.slug === h.tag))
).map(({ tag, label }) => ({ slug: tag, label }));
// Likewise for product types.
const types = PRODUCT_TYPES.filter(p =>
  details.some(e => e.productTypes.some(t => t.slug === p.tag))
).map(({ tag, label }) => ({ slug: tag, label }));
---

<Layout
  title="Search recalls — Baby Safety Site"
  description="Search every children's product recall on this site by product, brand, store, product type, or hazard."
>
  <main id="main" tabindex="-1" class="mx-auto max-w-3xl p-4">
    <h1 class="mb-2 text-2xl font-bold">Search recalls</h1>
    <p class="mb-6 text-base-content/80">
      Type a product, brand, or store to check whether something you own has been recalled.
    </p>
    {
      details.length === 0 ? (
        <div class="alert alert-info">
          <span>No recalls to show yet — the recall database has not been populated.</span>
        </div>
      ) : (
        <RecallSearch
          initial={initial}
          total={details.length}
          pageSize={LIST_PAGE_SIZE}
          indexUrl={withBase('/recalls/search-index.json')}
          hazards={hazards}
          types={types}
          client:load
        />
      )
    }
  </main>
</Layout>
