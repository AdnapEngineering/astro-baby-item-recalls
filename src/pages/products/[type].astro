---
import RecallListItem from '../../components/RecallListItem.tsx';
import Layout from '../../layouts/Layout.astro';
import { withBase } from '../../lib/nav';
import { getProductTypeGroups, type ProductTypeRecallGroup } from '../../lib/product-types';

// Data → routes: one static page per product type that at least one recall carries. The
// group rides along as a prop so the page needs no second query.
export async function getStaticPaths() {
  const groups = await getProductTypeGroups();
  return groups.map(group => ({ params: { type: group.slug }, props: { group } }));
}

const { group } = Astro.props as { group: ProductTypeRecallGroup };
const count = group.recalls.length;
---

<Layout
  title={`${group.name} recalls — Baby Safety Site`}
  description={`Children's product recalls for ${group.name.toLowerCase()}.`}
>
  <main id="main" tabindex="-1" class="mx-auto max-w-3xl p-4">
    <a href={withBase('/products/')} class="link link-primary mb-4 inline-block text-sm">
      ← All product types
    </a>
    <h1 class="mb-2 text-2xl font-bold">{group.name}</h1>
    <p class="mb-6 text-base-content/80">
      {count} recall{count === 1 ? '' : 's'} for this kind of product, newest first. To narrow by brand
      or hazard, <a href={withBase(`/recalls/?type=${group.slug}`)} class="link link-primary"
        >search within these recalls</a
      >.
    </p>

    {/* No client directive: the rows render to static HTML here, with no JS shipped. */}
    <ul class="space-y-3">
      {group.recalls.map(recall => <RecallListItem recall={recall} />)}
    </ul>
  </main>
</Layout>
