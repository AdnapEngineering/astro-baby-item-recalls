---
import RecallsIsland from './RecallsIsland.tsx';
import { fetchRecalls } from '../lib/recalls';

let initialData;
try {
  initialData = await fetchRecalls(7);
} catch {
  // API unavailable at build time — island will fetch client-side on load
}
---

<RecallsIsland days={7} initialData={initialData} client:load />
