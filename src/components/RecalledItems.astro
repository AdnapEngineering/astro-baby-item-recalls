---
import RecallsIsland from './RecallsIsland.tsx';
import { DEFAULT_DAYS, fetchRecalls, RecallSchemaError } from '../lib/recalls';

let initialData;
try {
  initialData = await fetchRecalls(DEFAULT_DAYS);
} catch (err) {
  // A shape change is a real defect — fail the build rather than ship blank cards.
  if (err instanceof RecallSchemaError) throw err;
  // API merely unavailable at build time — island will fetch client-side on load.
  console.warn('[recalls] build-time fetch failed, falling back to client fetch:', err);
}
---

<RecallsIsland days={DEFAULT_DAYS} initialData={initialData} client:load />
