---
import { isActive, navLinks, withBase } from '../lib/nav';

// Astro.url.pathname includes the base path, which is why navLinks are built
// with withBase() — both sides of the comparison are already prefixed.
const { pathname } = Astro.url;
---

<header
  class="flex flex-col items-center gap-2 bg-base-100 p-3 shadow-sm sm:flex-row sm:justify-between"
>
  <div>
    <a href={withBase('/')} class="btn btn-ghost text-lg font-bold text-primary"> Baby Safety </a>
  </div>

  <nav aria-label="Main">
    {/* Wraps rather than overflowing the viewport on narrow phones. */}
    <ul class="menu menu-horizontal flex-wrap justify-center gap-1 px-1">
      {
        navLinks.map(link => {
          const active = isActive(pathname, link.href);
          return (
            <li>
              <a
                href={link.href}
                class:list={['min-h-11 font-medium', { 'menu-active underline': active }]}
                aria-current={active ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
</header>
